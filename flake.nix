{
  description = "yajna: tooling for a markdown-first lab notebook";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs = { self, nixpkgs, ... }:
    let
      systems = [ "aarch64-darwin" "x86_64-darwin" "x86_64-linux" "aarch64-linux" ];
      forAll = f: nixpkgs.lib.genAttrs systems (system: f nixpkgs.legacyPackages.${system});
    in {
      packages = forAll (pkgs: rec {
        # The yajna CLI (ADR-0017): one static binary with schema/ and templates/ embedded.
        yajna = pkgs.rustPlatform.buildRustPackage {
          pname = "yajna";
          version = "0.38.0";
          src = self;
          # the workspace: the CLI and the yajna-serve library it links (ADR-0027)
          sourceRoot = "source/tools";
          cargoLock.lockFile = ./tools/Cargo.lock;
          # nixpkgs' cargo hook makes libsqlite3-sys and zstd-sys link the system libraries
          # through pkg-config instead of their bundled copies, so the build provides them
          nativeBuildInputs = [ pkgs.pkg-config ];
          buildInputs = [ pkgs.sqlite pkgs.zstd ];
          # the graduate test drives `git subtree`; the sync test renders citations with pandoc
          nativeCheckInputs = [ pkgs.git pkgs.pandoc ];
          # lib.getExe (home-manager, nix run) warns without it
          meta.mainProgram = "yajna";
        };
        default = yajna;
        # Protocols as code (docs/protocol-framework.md, ADR-0037): a standard-library Python
        # package; `yajna-protocol ir|render|page`. Its tests run in the check phase.
        yajna-protocol = pkgs.python3Packages.buildPythonApplication {
          pname = "yajna-protocol";
          version = "0.1.0";
          pyproject = true;
          src = ./tools/yajna-protocol;
          build-system = [ pkgs.python3Packages.setuptools ];
          nativeCheckInputs = [ pkgs.python3Packages.jsonschema ];
          checkPhase = ''
            runHook preCheck
            PYTHONPATH=src''${PYTHONPATH:+:$PYTHONPATH} python -m unittest discover -s tests -v
            runHook postCheck
          '';
          meta.mainProgram = "yajna-protocol";
        };
        # The files viewer's frontend (ADR-0029): type-checked and bundled with tsc and
        # esbuild from nixpkgs over the locked npm dependencies. `nix run .#ui` copies it
        # into tools/yajna-serve/ui/dist, which is committed and embedded in the binary.
        yajna-ui = pkgs.stdenv.mkDerivation {
          pname = "yajna-files-ui";
          version = "0.1.0";
          src = ./tools/yajna-serve/ui;
          npmDeps = pkgs.importNpmLock { npmRoot = ./tools/yajna-serve/ui; };
          npmFlags = [ "--ignore-scripts" ];
          nativeBuildInputs = [ pkgs.nodejs pkgs.importNpmLock.npmConfigHook pkgs.esbuild pkgs.typescript ];
          buildPhase = "sh build.sh";
          installPhase = "cp -r dist $out";
        };
        # The web app (ADR-0041): React, type-checked and bundled with tsc and esbuild from
        # nixpkgs over the locked npm dependencies. `nix run .#web` copies it into
        # tools/yajna-serve/web/dist, which is committed and embedded in the binary.
        yajna-web = pkgs.stdenv.mkDerivation {
          pname = "yajna-web";
          version = "0.1.0";
          src = ./tools/yajna-serve/web;
          npmDeps = pkgs.importNpmLock { npmRoot = ./tools/yajna-serve/web; };
          npmFlags = [ "--ignore-scripts" ];
          nativeBuildInputs = [ pkgs.nodejs pkgs.importNpmLock.npmConfigHook pkgs.esbuild pkgs.typescript ];
          buildPhase = "sh build.sh";
          installPhase = "cp -r dist $out";
        };
        # Neovim plugin (phase 0c): follow [[ID]] links and @citekeys, find entities, backlinks.
        yajna-nvim = pkgs.vimUtils.buildVimPlugin {
          pname = "yajna.nvim";
          version = "0.2.0";
          src = ./tools/yajna.nvim;
        };
        # The user guide for GitHub Pages: mdBook, with the CLI reference, page types and
        # design section generated by docs/guide/build.py.
        docs = pkgs.runCommand "yajna-docs" {
          nativeBuildInputs = [ yajna pkgs.mdbook pkgs.python3 ];
        } ''
          python3 ${./docs/guide/build.py} ${self} $out
        '';
      });

      # `nix run .#ui` from the repo root: rebuild the files viewer's committed bundle.
      apps = forAll (pkgs: {
        ui = {
          type = "app";
          program = toString (pkgs.writeShellScript "yajna-ui" ''
            set -eu
            dest=tools/yajna-serve/ui/dist
            [ -f tools/yajna-serve/ui/package.json ] || { echo "run from the yajna repo root" >&2; exit 1; }
            rm -rf "$dest"
            cp -r ${self.packages.${pkgs.system}.yajna-ui} "$dest"
            chmod -R u+w "$dest"
            echo "$dest: rebuilt"
          '');
        };
        # `nix run .#web`: rebuild the web app's committed bundle.
        web = {
          type = "app";
          program = toString (pkgs.writeShellScript "yajna-web" ''
            set -eu
            dest=tools/yajna-serve/web/dist
            [ -f tools/yajna-serve/web/package.json ] || { echo "run from the yajna repo root" >&2; exit 1; }
            rm -rf "$dest"
            cp -r ${self.packages.${pkgs.system}.yajna-web} "$dest"
            chmod -R u+w "$dest"
            echo "$dest: rebuilt"
          '');
        };
      });

      devShells = forAll (pkgs:
        let
          # Runs the checked-out source, so edits under tools/yajna take effect immediately.
          yajnaDev = pkgs.writeShellScriptBin "yajna" ''
            exec cargo run --quiet --manifest-path "''${YAJNA_SRC:?run inside nix develop}/Cargo.toml" -- "$@"
          '';
          # Likewise the protocol framework, from tools/yajna-protocol/src.
          python = pkgs.python3.withPackages (ps: [ ps.jsonschema ]);
          protocolDev = pkgs.writeShellScriptBin "yajna-protocol" ''
            PYTHONPATH="''${YAJNA_PROTOCOL_SRC:?run inside nix develop}''${PYTHONPATH:+:$PYTHONPATH}" \
              exec ${python}/bin/python3 -m yajna_protocol "$@"
          '';
        in {
          default = pkgs.mkShell {
            packages = [ yajnaDev protocolDev pkgs.git pkgs.cargo pkgs.rustc pkgs.clippy pkgs.rustfmt pkgs.rust-analyzer python pkgs.mdbook pkgs.pandoc
              # the files viewer's frontend (tools/yajna-serve/ui, ADR-0029)
              pkgs.nodejs pkgs.esbuild pkgs.typescript ];
            shellHook = ''
              export YAJNA_SRC="$PWD/tools/yajna"
              export YAJNA_PROTOCOL_SRC="$PWD/tools/yajna-protocol/src"
            '';
          };
        });

      checks = forAll (pkgs: {
        # buildRustPackage runs `cargo test` over the workspace: the CLI's and the server's tests.
        yajna = self.packages.${pkgs.system}.yajna;
        # this repo is a project-shaped yajna repo: its own notebook must validate
        notes = pkgs.runCommand "yajna-notes" {
          nativeBuildInputs = [ self.packages.${pkgs.system}.yajna ];
        } ''
          cd ${self}
          yajna --root . validate
          # and so must the protocol framework's example lab (the guide's worked example)
          yajna --root tools/yajna-protocol/examples/lab validate
          touch $out
        '';
        # the committed bundle of the files viewer is what its source builds to
        ui-bundle = pkgs.runCommand "yajna-ui-bundle" { } ''
          diff -r ${self.packages.${pkgs.system}.yajna-ui} ${./tools/yajna-serve/ui/dist} \
            || { echo "tools/yajna-serve/ui/dist is stale: run nix run .#ui" >&2; exit 1; }
          touch $out
        '';
        # and the web app's
        web-bundle = pkgs.runCommand "yajna-web-bundle" { } ''
          diff -r ${self.packages.${pkgs.system}.yajna-web} ${./tools/yajna-serve/web/dist} \
            || { echo "tools/yajna-serve/web/dist is stale: run nix run .#web" >&2; exit 1; }
          touch $out
        '';
        # the guide builds and every relative link in it resolves
        docs = self.packages.${pkgs.system}.docs;
        # the protocol framework's tests, including the IR against its JSON schema
        yajna-protocol = self.packages.${pkgs.system}.yajna-protocol;
        # the review tests drive the CLI and git against a scratch repo
        yajna-nvim = pkgs.runCommand "yajna-nvim-tests" {
          nativeBuildInputs = [ pkgs.neovim pkgs.git self.packages.${pkgs.system}.yajna ];
        } ''
          export HOME=$TMPDIR YAJNA_BIN=yajna
          nvim --headless -u NONE --cmd "set rtp^=${self}/tools/yajna.nvim" -l ${self}/tools/yajna.nvim/tests/run.lua
          touch $out
        '';
      });
    };
}
