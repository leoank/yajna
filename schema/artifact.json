{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yajna.local/schema/v1/artifact.json",
  "title": "artifact",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "created",
    "author",
    "title",
    "store",
    "path"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ART-\\d{8}-[0-9a-z]{4}([0-9a-z]{2})?$"
    },
    "type": {
      "const": "artifact"
    },
    "schema_version": {
      "const": 1
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "author": {
      "type": "string",
      "pattern": "^(agent:)?[a-z][a-z0-9_-]*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "enum": [
        "pending",
        "approved"
      ]
    },
    "session": {
      "type": "string",
      "pattern": "^AGS-\\d{8}-[0-9a-z]{4}([0-9a-z]{2})?$"
    },
    "title": {
      "type": "string"
    },
    "run": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_-]*/)?RUN-\\d{8}-[0-9a-z]{4}([0-9a-z]{2})?$"
    },
    "project": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_-]*/)?PRJ-\\d{4,}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "store": {
      "enum": [
        "git",
        "path",
        "annex"
      ]
    },
    "path": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string"
    },
    "sync": {
      "type": "object",
      "description": "Google Docs sync (architecture 5.8): provider, mode, and the doc ID allocated on first publish",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "enum": [
            "gdoc"
          ]
        },
        "mode": {
          "enum": [
            "publish",
            "mirror",
            "import"
          ]
        },
        "doc_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "description": "Who signed the page off and when: in a review (`in`), or on the page itself (`yajna approve`)",
      "required": [
        "by",
        "on"
      ],
      "properties": {
        "by": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "in": {
          "type": "string",
          "pattern": "^REV-\\d{8}-[0-9a-z]{4}([0-9a-z]{2})?$"
        }
      }
    }
  },
  "additionalProperties": true
}
