{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yajna.local/schema/v1/project.json",
  "title": "project",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "created",
    "author",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PRJ-\\d{4,}$"
    },
    "type": {
      "const": "project"
    },
    "schema_version": {
      "const": 1
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "author": {
      "type": "string",
      "pattern": "^(agent:)?[a-z][a-z0-9_-]*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "enum": [
        "pending",
        "approved"
      ]
    },
    "session": {
      "type": "string",
      "pattern": "^AGS-\\d{8}-[a-z2-7]{4}$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "concluded",
        "moved",
        "archived"
      ]
    },
    "code": {
      "description": "Where the code lives: a path under projects/ while it is in this repo, a repository URL after it moves out",
      "type": [
        "string",
        "null"
      ]
    },
    "continued_in": {
      "type": "string",
      "description": "namespace/PRJ-xxxx of the project page that continues this one after it moved"
    }
  },
  "additionalProperties": true
}
