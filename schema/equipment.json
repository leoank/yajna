{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yajna.local/schema/v1/equipment.json",
  "title": "equipment",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "created",
    "author",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EQP-\\d{4,}$"
    },
    "type": {
      "const": "equipment"
    },
    "schema_version": {
      "const": 1
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "author": {
      "type": "string",
      "pattern": "^(agent:)?[a-z][a-z0-9_-]*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "enum": [
        "pending",
        "approved"
      ]
    },
    "session": {
      "type": "string",
      "pattern": "^AGS-\\d{8}-[a-z2-7]{4}$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "available",
        "booked",
        "broken",
        "retired"
      ]
    },
    "location": {
      "type": "string"
    },
    "produced_by": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_-]*/)?BLD-\\d{4,}$"
    },
    "calibration_valid_until": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": true
}
