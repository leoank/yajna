{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yajna.local/schema/v1/build.json",
  "title": "build",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "created",
    "author",
    "title",
    "revision",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^BLD-\\d{4,}$"
    },
    "type": {
      "const": "build"
    },
    "schema_version": {
      "const": 1
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "author": {
      "type": "string",
      "pattern": "^(agent:)?[a-z][a-z0-9_-]*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "enum": [
        "pending",
        "approved"
      ]
    },
    "session": {
      "type": "string",
      "pattern": "^AGS-\\d{8}-[0-9a-z]{4}([0-9a-z]{2})?$"
    },
    "title": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_-]*/)?PRJ-\\d{4,}$"
    },
    "status": {
      "enum": [
        "designing",
        "ordering",
        "assembling",
        "testing",
        "deployed",
        "retired"
      ]
    },
    "sources": {
      "type": "string"
    },
    "produces": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_-]*/)?EQP-\\d{4,}$"
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9_-]*/)?MAT-\\d{4,}$"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9_-]*/)?EXP-(\\d{4,}|\\d{8}-[0-9a-z]{4}([0-9a-z]{2})?)$"
      }
    },
    "sync": {
      "type": "object",
      "description": "Google Docs sync (architecture 5.8): provider, mode, and the doc ID allocated on first publish",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "enum": [
            "gdoc"
          ]
        },
        "mode": {
          "enum": [
            "publish",
            "mirror",
            "import"
          ]
        },
        "doc_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "description": "Who signed the page off and when: in a review (`in`), or on the page itself (`yajna approve`)",
      "required": [
        "by",
        "on"
      ],
      "properties": {
        "by": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "in": {
          "type": "string",
          "pattern": "^REV-\\d{8}-[0-9a-z]{4}([0-9a-z]{2})?$"
        }
      }
    }
  },
  "additionalProperties": true
}
