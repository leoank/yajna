{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yajna.local/schema/v1/review.json",
  "title": "review",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "created",
    "author",
    "title",
    "target",
    "base",
    "head",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REV-\\d{8}-[0-9a-z]{4}([0-9a-z]{2})?$"
    },
    "type": {
      "const": "review"
    },
    "schema_version": {
      "const": 1
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "author": {
      "type": "string",
      "pattern": "^(agent:)?[a-z][a-z0-9_-]*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "session": {
      "type": "string",
      "pattern": "^AGS-\\d{8}-[0-9a-z]{4}([0-9a-z]{2})?$"
    },
    "title": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([a-z][a-z0-9_-]*/)?PRJ-\\d{4,}$"
    },
    "target": {
      "type": "object",
      "description": "What was asked for: a branch, a commit range A..B, a page ID, a run, an experiment, or a project phase (ref is the project, phase the item)",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "branch",
            "range",
            "page",
            "run",
            "experiment",
            "phase"
          ]
        },
        "ref": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "description": "The Progress item of a phase target, without its (since …)"
        }
      },
      "additionalProperties": false
    },
    "base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The commit the diff starts from, resolved when the review was opened"
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The commit the diff ends at; review update moves it"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths the diff is limited to, relative to the repo root; empty for everything"
    },
    "status": {
      "enum": [
        "open",
        "changes_requested",
        "approved",
        "merged",
        "closed"
      ]
    },
    "merge": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The branch commit `yajna review merge` merged; the merge commit is the one whose second parent it is"
    },
    "about": {
      "type": "array",
      "description": "The pages the review is about besides its target: experiments, runs, a project; approving it signs those that wait for review",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3}-\\d{4,8}(-[0-9a-z]{4,6})?$"
      }
    }
  },
  "additionalProperties": true
}
